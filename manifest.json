{
  "manifest_version": 3,
  "name": "Maia 3 · 人类直觉热力图与预测器",
  "version": "1.0.0",
  "description": "基于 WebGPU / WebAssembly 驱动的 Maia 3 (Chessformer) 人类直觉预测插件，在 Lichess / Chess.com 实时呈现直觉热力图与着法预测。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Maia 3 人类直觉设置"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://*.chess.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.chess.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "engine/*",
        "models/*",
        "lib/*",
        "icons/*"
      ],
      "matches": [
        "https://lichess.org/*",
        "https://*.chess.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
