{
  "manifest_version": 3,
  "name": "Maia 3 · 人类直觉热力图与预测器",
  "version": "1.0.0",
  "description": "纯浏览器端运行的 Maia 3 人类直觉与 Stockfish 19 双引擎研判扩展，在 Lichess / Chess.com 提供赛后深度复盘与局面研判。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Maia 3 人类直觉设置"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://*.chess.com/*",
    "https://weights.4chess.cc/*",
    "https://maia3-cdn.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.chess.com/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.chess.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine/stockfish-sandbox.html",
        "engine/stockfish-sandbox.js",
        "lib/stockfish-19.js",
        "lib/stockfish.wasm",
        "models/maia3_model.bin",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://lichess.org/*",
        "https://*.chess.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
