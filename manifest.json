{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.2",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://*.lichess.org/*",
    "https://chess.com/*",
    "https://*.chess.com/*",
    "https://weights.4chess.cc/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*",
        "https://chess.com/*",
        "https://*.chess.com/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*",
        "https://chess.com/*",
        "https://*.chess.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "ui/theme.css",
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "engine/*",
        "lib/stockfish-19.js",
        "lib/stockfish.wasm",
        "icons/*",
        "ui/*"
      ],
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*",
        "https://chess.com/*",
        "https://*.chess.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
