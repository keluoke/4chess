{
  "name": "歧路 Diverge · 局面分析与棋局复盘",
  "short_name": "歧路 Diverge",
  "description": "对比 Stockfish 引擎建议与 Maia 人类直觉，探索网页棋图、FEN 局面、个人分支与完赛棋局。",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f2ec",
  "theme_color": "#f3f2ec",
  "orientation": "any",
  "categories": [
    "games",
    "utilities"
  ],
  "icons": [
    {
      "src": "../icons/icon48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "../icons/icon128.png",
      "sizes": "128x128",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Chess PGN File",
      "accept": {
        "application/x-chess-pgn": [
          ".pgn"
        ],
        "text/plain": [
          ".pgn",
          ".txt"
        ]
      }
    }
  ]
}
