{
  "name": "4Chess Review | 直觉与引擎深度复盘",
  "short_name": "4Chess Review",
  "description": "基于 Maia-3 人类直觉模型与 Stockfish 双引擎的纯前端深度复盘工作台",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0f19",
  "theme_color": "#121826",
  "orientation": "any",
  "categories": ["games", "utilities"],
  "icons": [
    {
      "src": "../icons/icon48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "../icons/icon128.png",
      "sizes": "128x128",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Chess PGN File",
      "accept": {
        "application/x-chess-pgn": [".pgn"],
        "text/plain": [".pgn", ".txt"]
      }
    }
  ]
}
